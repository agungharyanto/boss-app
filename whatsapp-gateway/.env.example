# Gateway WhatsApp (Go + whatsmeow) — menggantikan gateway Node/Baileys
# lama sejak migrasi selesai. HMAC_SECRET WAJIB nilai BYTE-UNTUK-BYTE SAMA
# dengan WHATSAPP_GATEWAY_HMAC_SECRET Laravel.
PORT=3000
WHATSAPP_GATEWAY_HMAC_SECRET=CHANGE_ME_STRONG_SHARED_SECRET
LARAVEL_BASE_URL=http://boss-nginx
LOG_LEVEL=info

# DSN Postgres ke database logis whatsmeow_store DI DALAM container
# boss-postgresql yang SAMA (BUKAN instance Postgres terpisah seperti
# freeradius-db) — lihat docs/whatsapp-gateway-api-surface.md bagian 3.
WHATSMEOW_DB_DSN=postgres://boss_app:CHANGE_ME@boss-postgresql:5432/whatsmeow_store?sslmode=disable
