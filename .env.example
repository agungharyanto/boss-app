# ============================================
# BOSS App — Environment Template
# Copy ke .env lalu isi nilai asli. JANGAN commit .env
# ============================================

APP_NAME="BOSS App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=boss-postgresql
DB_PORT=5432
DB_DATABASE=boss_db
DB_USERNAME=boss_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_HOST=boss-redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- PostgreSQL container init (dipakai docker-compose) ---
POSTGRES_DB=boss_db
POSTGRES_USER=boss_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Xendit Payment Gateway (v0.3.5) — SANDBOX only this sprint ---
# Test-mode keys from the Xendit dashboard. JANGAN pernah isi production
# key di sini selama sprint ini masih berjalan di server dev — lihat
# CLAUDE.md untuk kenapa root .env ini adalah yang benar-benar dibaca
# container (bukan app/.env).
XENDIT_SECRET_KEY=CHANGE_ME_XENDIT_SANDBOX_SECRET_KEY
XENDIT_CALLBACK_TOKEN=CHANGE_ME_XENDIT_SANDBOX_CALLBACK_TOKEN
XENDIT_IS_PRODUCTION=false

# --- WhatsApp Gateway (Baileys, v0.4.0) ---
# whatsapp-gateway is a separate Node.js container on boss-network (see
# docker-compose.yml) — internal-only, never exposed to a host port.
# WHATSAPP_GATEWAY_HMAC_SECRET is an infra-level shared secret (like
# APP_KEY), NOT a business credential — it must be set to the SAME value
# in this file's real .env AND whatsapp-gateway/.env, or every signed
# request between the two services fails verification.
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3000
WHATSAPP_GATEWAY_HMAC_SECRET=CHANGE_ME_STRONG_SHARED_SECRET

# --- FreeRADIUS (v0.6.1) ---
# freeradius-db is a SEPARATE Postgres container from boss-postgresql
# (BOSS-009: radius_db logically separated from boss_db, no cross-database
# joins) — these values configure BOTH the freeradius-db container's own
# POSTGRES_* init AND the freeradius container's rlm_sql connection string
# (see docker/freeradius/mods-available/sql, read via $ENV{RADIUS_DB_*}).
# Mikrotik API credentials themselves are NOT here — they're per-NAS,
# encrypted columns on the `nas` table (see NasService), not a global env.
RADIUS_DB_HOST=freeradius-db
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius_db
RADIUS_DB_USER=freeradius
RADIUS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Infra tunnel block (v0.8.1) ---
# INFRA_TUNNEL_BLOCK_CIDR replaces the old per-service /32 allowlist model.
# Through v0.7.7, every service allowed to send traffic through a NAS's
# WireGuard tunnel (FreeRADIUS, GenieACS CWMP/NBI) got its own individual
# /32 hand-added to the router's `allowed-address` — this worked but meant
# the router had to be touched again for every new module (LibreNMS's OLT
# onboarding was the case that surfaced this: adding it the old way would
# have been a 5th manual router edit, on top of the 3 that already existed).
#
# v0.8.1 replaces this with ONE reserved /27 block (32 addresses) on
# boss-network — every "infra" container that legitimately needs to reach
# through a NAS's tunnel gets a pinned IP inside this block, and the
# router's `allowed-address`/reverse-route is generated ONCE as a single
# CIDR (see MikrotikScriptGenerator::wireGuardScript()) instead of an
# ever-growing /32 list. A brand-new module just needs a free IP inside
# this block — the router config stays untouched.
#
# DELIBERATE, CONSCIOUS security trade-off (confirmed explicitly with
# Agung, not scope drift) — the v0.6.2 hub-and-spoke design intentionally
# locked `allowed-address` to specific /32s ("FreeRADIUS selalu diakses di
# SATU IP internal tetap"); this widens that to block-level (any of the 32
# addresses in this range is now trusted by the tunnel) in exchange for a
# genuinely modular product (an ISP can buy just GenieACS, or just
# LibreNMS, without a router re-touch per combination). See CLAUDE.md's
# "Infra Tunnel IP Block" section for the full reasoning and the address
# map.
#
# Block chosen: 172.28.0.224/27 (.224-.255) — completely unused range,
# confirmed via `docker network inspect` before picking it (nothing above
# .31 was ever assigned). .224 (block base) and .255 (the /24's own
# broadcast address, which Docker refuses to assign to any container
# regardless) are deliberately left unused as the block's own
# network/broadcast-equivalent boundary, even though Docker doesn't
# require this for an address range that isn't a literal separate subnet
# — purely for a human reading `allowed-address=172.28.0.224/27` on the
# router later not to be confused by a host sitting on what looks like the
# block's own network address.
INFRA_TUNNEL_BLOCK_CIDR=172.28.0.224/27

# FREERADIUS_INTERNAL_IP must match the ipv4_address pinned to the
# freeradius service on boss-network in docker-compose.yml — the openvpn
# container's push-route AND its iptables FORWARD allowlist are both keyed
# off this exact value (see docker/openvpn/entrypoint.sh). Must stay inside
# INFRA_TUNNEL_BLOCK_CIDR above.
FREERADIUS_INTERNAL_IP=172.28.0.225

# GENIEACS_CWMP_INTERNAL_IP/GENIEACS_NBI_INTERNAL_IP (v0.7.3) must match the
# ipv4_address pinned to genieacs-cwmp/genieacs-nbi on boss-network in
# docker-compose.yml — the Connection Request firewall exception in
# docker/wireguard/entrypoint.sh (and openvpn's, for any NAS on that
# protocol) is keyed off these exact values, same "must not silently drift
# on container recreation" reasoning as FREERADIUS_INTERNAL_IP above. Must
# stay inside INFRA_TUNNEL_BLOCK_CIDR above.
GENIEACS_CWMP_INTERNAL_IP=172.28.0.226
GENIEACS_NBI_INTERNAL_IP=172.28.0.227

# LIBRENMS_INTERNAL_IP/LIBRENMS_DISPATCHER_INTERNAL_IP (v0.8.1) — pinned
# ipv4_address for the librenms (web/API) and librenms-dispatcher (the
# actual SNMP poller, librenms-service.py) containers. BOTH need to be
# inside the tunnel-allowed block: librenms-dispatcher for ongoing polling,
# librenms itself because `POST /api/v0/devices`' own add-time reachability
# check runs synchronously in that container, not delegated to the
# dispatcher. See docker/wireguard/entrypoint.sh for the OLT management
# subnet route/firewall this enables.
LIBRENMS_INTERNAL_IP=172.28.0.228
LIBRENMS_DISPATCHER_INTERNAL_IP=172.28.0.229

# WIREGUARD_NODE2_INTERNAL_IP/WIREGUARD_NODE3_INTERNAL_IP (added 2026-08-19,
# same day as the GATEWAY variable below) — pinned ipv4_address for
# wireguard-node2/wireguard-node3 on boss-network. Found missing during the
# Connection Request (v0.7.3) investigation: unlike wireguard (node1,
# BELIEVED already pinned to 172.28.0.11 at the time — see
# WIREGUARD_NODE1_INTERNAL_IP below for why that belief turned out to be
# wrong) and every other special-purpose container in this stack, node2/
# node3 had NO ipv4_address at all, so a plain recreate silently
# reassigned their addresses (confirmed for real: node3 was 172.28.0.4,
# became 172.28.0.5 after one `docker compose up -d --force-recreate`) —
# which immediately broke TR069_MANAGEMENT_GATEWAY below, the exact "must
# not silently drift on container recreation" failure mode
# FREERADIUS_INTERNAL_IP/GENIEACS_*_INTERNAL_IP already exist to prevent,
# just never extended to these two services until now.
WIREGUARD_NODE2_INTERNAL_IP=172.28.0.4
WIREGUARD_NODE3_INTERNAL_IP=172.28.0.5

# WIREGUARD_NODE1_INTERNAL_IP (v0.8.1) — node1 turned out to have NEVER
# actually been pinned, contrary to what the comment above (and this file,
# until now) claimed. Found live: recreating `wireguard` (node1) for the
# infra-tunnel-block migration silently grabbed 172.28.0.4
# (wireguard-node2's own address, since Docker just hands out the next
# free one) instead of its expected .11 — `container_name: wireguard` only
# fixes the container's NAME, it does nothing for its network IP. Nothing
# had recreated node1 since the original (incorrect) v0.7.3 comment was
# written, so this gap sat undiscovered. .11 is confirmed via `docker
# network inspect` as node1's actual long-standing address before this fix.
WIREGUARD_NODE1_INTERNAL_IP=172.28.0.11

# TR069_MANAGEMENT_SUBNET (v0.7.3) — optional. When set, every WireGuard
# pool node (docker/wireguard/entrypoint.sh) adds a scoped firewall
# exception + AllowedIPs widening so GenieACS Connection Request can reach
# CPE behind whichever NAS actually has this exact subnet in its own
# nas.tr069_management_subnet column. Leave unset if no NAS has Connection
# Request routing configured yet. Only one subnet is supported this sprint
# (no per-NAS dynamic sync) — see CLAUDE.md "GenieACS Vendor Parameter
# Mapping" for the known limitation if this ever needs to support multiple
# NAS with DIFFERENT management subnets simultaneously.
TR069_MANAGEMENT_SUBNET=
# TR069_MANAGEMENT_GATEWAY — boss-network IP of whichever VPN pool node
# currently holds the relevant NAS's active WireGuard account (cross-check
# vpn_accounts.vpn_server_id -> vpn_servers.hostname against `docker
# network inspect`, or now, simpler: use the matching
# WIREGUARD_NODE2_INTERNAL_IP/WIREGUARD_NODE3_INTERNAL_IP value above /
# 172.28.0.11 for node1 — all three are pinned now, so this is the one
# thing here that's still genuinely static/manual: which NODE currently
# owns the NAS, not which IP that node has). Static/manual, known
# limitation — must be updated by hand if that NAS's account ever moves to
# a different pool node.
TR069_MANAGEMENT_GATEWAY=

# OLT_MANAGEMENT_SUBNET/OLT_MANAGEMENT_GATEWAY (v0.8.1) — same shape and
# same known limitation as TR069_MANAGEMENT_SUBNET/TR069_MANAGEMENT_GATEWAY
# above (one subnet only, static/manual, must be updated by hand if the
# NAS's account moves to a different pool node) — a SEPARATE pair, not a
# reuse of the TR069 ones, because a NAS can have BOTH a CPE/TR-069
# management subnet AND a different OLT management subnet at the same time
# (test-x86-bajastu does: 10.1.0.0/20 for TR-069, 10.168.100.0/24 for OLT).
# When set, docker/wireguard/entrypoint.sh adds a scoped route + firewall
# exception (source = INFRA_TUNNEL_BLOCK_CIDR, not individual /32s — see
# that file's own comment) so LibreNMS can SNMP-poll OLTs behind this NAS;
# docker/librenms/route-init.sh (bind-mounted into librenms/librenms-
# dispatcher, official images with no custom Dockerfile of our own) adds
# the matching route on their side, GATEWAY being whichever pool node
# currently holds this NAS's account (same
# WIREGUARD_NODE2_INTERNAL_IP/WIREGUARD_NODE3_INTERNAL_IP/172.28.0.11
# cross-check as TR069_MANAGEMENT_GATEWAY above). Leave both unset if no
# NAS has OLT SNMP routing configured yet.
OLT_MANAGEMENT_SUBNET=
OLT_MANAGEMENT_GATEWAY=

# v0.8.1 — OSPF dynamic routing. Replaces the static
# TR069_MANAGEMENT_GATEWAY/OLT_MANAGEMENT_GATEWAY/freeradius
# refresh_coa_routes() mechanisms above, one container at a time as each is
# migrated — see CLAUDE.md's OSPF section for the full design (FRR sidecar
# per container, 3 WireGuard nodes redistribute a handshake-conditional
# static route, 5 consumers learn only, never redistribute). OSPF_AUTH_KEY
# is a shared MD5 auth key across all 8 sidecars (one OSPF domain, one key
# — infra-level secret like WHATSAPP_GATEWAY_HMAC_SECRET/L2TP_IPSEC_PSK,
# generate with `openssl rand -hex 8`, FRR's OSPF MD5 key field is capped
# at 16 characters). OSPF_ROUTING_ENABLED gates whether each modified
# entrypoint.sh (freeradius/genieacs/librenms route-init) still installs
# its OLD static route or defers to OSPF — flip only after that specific
# container's FRR sidecar has verified adjacency + correct learned routes,
# never globally all at once.
OSPF_AUTH_KEY=
OSPF_HELLO_INTERVAL=1
OSPF_DEAD_INTERVAL=4
OSPF_ROUTING_ENABLED=false

# --- OpenVPN Server Node #1 (v0.6.2) ---
# VPN_SUBNET_* is the internal pool OpenVPN hands out to connecting NAS
# clients (must match vpn_servers.subnet_cidr for the node whose row
# represents this container — kept as plain env here since the openvpn
# container's own server.conf needs it before any DB even exists to read
# from). NETWORK/NETMASK are the same range as CIDR, just pre-split because
# OpenVPN's `server` directive wants netmask form, not CIDR notation.
VPN_SUBNET_CIDR=172.23.194.0/24
VPN_SUBNET_NETWORK=172.23.194.0
VPN_SUBNET_NETMASK=255.255.255.0

# The public IP NAS devices actually dial — same value across all three VPN
# protocol containers (one physical/virtual server, N=1 node), also stored
# in each vpn_servers row's public_ip column.
VPN_PUBLIC_IP=YOUR_SERVER_IP

# --- WireGuard (v0.6.3) --- own subnet, distinct from OpenVPN's, so the
# two containers never hand out overlapping internal_ip values.
WG_LISTEN_PORT=51820
WG_SUBNET_CIDR=172.23.195.0/24

# WG_SUBNET_NETWORK_ADDR (v0.6.3-v0.8.0) — NO LONGER READ by
# docker/wireguard/entrypoint.sh as of v0.8.1 (each NAS now gets its own
# dedicated /30 block instead of everyone sharing this one address — see
# CLAUDE.md's "WireGuard /30 Per-NAS Tunnel Blocks" section). Left here,
# unread, rather than deleted — harmless to leave set, and removing it
# outright risks looking like a real config regression to anyone diffing
# this file against an older deployment's .env.
WG_SUBNET_NETWORK_ADDR=172.23.195.1

# WG_NAS_GATEWAY_IP (v0.8.1) — deliberately optional, same "one NAS only,
# static/manual" limitation as TR069_MANAGEMENT_GATEWAY/
# OLT_MANAGEMENT_GATEWAY below. Pins the MASQUERADE `--to-source` used for
# TR069/OLT reverse routing to ONE specific NAS's own /30 gateway
# (VpnWireguardNasBlock.gateway_ip) — needed because wg0 can now carry
# several NAS gateways at once, so a plain unscoped MASQUERADE is
# ambiguous about which one to rewrite to. A genuinely multi-NAS-aware
# version (matching destination subnet to the correct NAS automatically)
# is a known, documented gap — see docker/wireguard/entrypoint.sh's own
# comment on this var. Leave unset if no NAS has TR069/OLT reverse
# routing configured yet.
WG_NAS_GATEWAY_IP=

# --- L2TP/IPsec (v0.6.3) --- L2TP_IPSEC_PSK is an infra-level shared secret
# (like WHATSAPP_GATEWAY_HMAC_SECRET) — ONE PSK for the whole node, not
# per-NAS (per-NAS identity/auth happens at the PPP/chap-secrets layer,
# via vpn_accounts.username/password).
L2TP_IPSEC_PSK=CHANGE_ME_STRONG_SHARED_SECRET
L2TP_LOCAL_IP=172.23.196.1
L2TP_IP_RANGE_START=172.23.196.10
L2TP_IP_RANGE_END=172.23.196.250
L2TP_SUBNET_CIDR=172.23.196.0/24

# --- GenieACS / MongoDB (v0.7.1) ---
# MongoDB is its own separate datastore for GenieACS — never boss_db/
# radius_db (BOSS-009: logically separated databases, no cross-database
# joins). Auth enabled even though the `mongo` container has no host port
# published and only genieacs-cwmp/nbi/fs ever talk to it — boss-network is
# shared with every other container in this stack, so credential-gating is
# still worthwhile defense-in-depth, same posture as boss-postgresql/
# freeradius-db even though those are also internal-only.
MONGO_DB_NAME=genieacs
MONGO_DB_USER=genieacs
MONGO_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# genieacs-nbi has NO authentication of its own (see docker-compose.yml's
# genieacs-nbi service comment) — network isolation (no host port, reached
# ONLY container-to-container inside boss-network) is its actual security
# boundary, so this URL only ever needs to be the internal container name.
GENIEACS_NBI_URL=http://genieacs-nbi:7557

# Signs JWT tokens genieacs-ui stores in browser cookies — only read by the
# genieacs-ui container itself (admin debugging UI, optional, no host port
# published), not by boss-app.
GENIEACS_UI_JWT_SECRET=CHANGE_ME_RANDOM_STRING

# --- Customer NIK encryption ---
# NIK_HMAC_KEY is an infra-level secret (like APP_KEY/WHATSAPP_GATEWAY_HMAC_SECRET),
# NOT reused from APP_KEY on purpose — it only ever hashes NIK values into
# customers.nik_hash (a deterministic HMAC, for unique-per-tenant lookups),
# never used to encrypt/decrypt anything itself. Rotating this key makes
# every existing nik_hash stop matching new lookups — don't rotate it
# without a re-backfill plan (see customers:backfill-nik-hash).
NIK_HMAC_KEY=CHANGE_ME_RANDOM_STRING

# --- CPE legacy device auto-matcher polling interval ---
# Read directly by boss-scheduler's entrypoint shell loop (docker-compose.yml),
# NOT by Laravel's Schedule — see routes/console.php's comment near
# AutoMatchLegacyDevices for why a sub-60s interval can't safely use
# Schedule::everyThirtySeconds() in this container's non-cron invocation
# pattern. 60 is the sane steady-state default; only go lower temporarily
# (e.g. while manually bulk-adding TR-069 profiles per-ONT and wanting fast
# match feedback) — changing this value needs `docker compose up -d
# boss-scheduler` to actually take effect (editing .env alone doesn't
# refresh an already-running container's env, same lesson as every other
# env_file entry in this file).
CPE_AUTO_MATCH_INTERVAL_SECONDS=60

# --- LibreNMS (v0.8.1) ---
# LIBRENMS_INTERNAL_IP/LIBRENMS_DISPATCHER_INTERNAL_IP live up in the
# "Infra tunnel block" section above, next to FREERADIUS_INTERNAL_IP/
# GENIEACS_*_INTERNAL_IP — same INFRA_TUNNEL_BLOCK_CIDR concept, kept
# together with its siblings rather than duplicated down here.
#
# librenms-db (mariadb) credentials — own separate MySQL/MariaDB instance,
# never boss-postgresql (BOSS-009, and LibreNMS itself requires MySQL/
# MariaDB, not Postgres, so reuse was never an option).
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=librenms
LIBRENMS_DB_PASSWORD=CHANGE_ME_RANDOM_STRING

# LIBRENMS_API_URL/LIBRENMS_API_TOKEN — container-to-container URL
# (http://librenms:8000/api/v0, no host port published — see docker-
# compose.yml's librenms service comment) + the API token generated via
# `docker compose exec librenms lnms api-token:create <username>` (or the
# web UI). Never hardcode the token in code — App\Services\Network\
# LibrenmsClientService (once it exists) reads these the same way
# GenieAcsClientService reads services.genieacs.nbi_url.
LIBRENMS_API_URL=http://librenms:8000/api/v0
LIBRENMS_API_TOKEN=

# v0.8.4 Bagian C — container-to-container URL to the docker-stats-proxy
# service (docker-compose.yml), never a direct docker.sock mount on
# boss-app/boss-scheduler themselves. The proxy only allows CONTAINERS=1
# (read-only container listing/stats) — every mutating endpoint family is
# denied at the proxy itself, not just avoided by application code. See
# CLAUDE.md "Container Stats via docker-socket-proxy (v0.8.4 Bagian C)".
DOCKER_STATS_PROXY_URL=http://docker-stats-proxy:2375
