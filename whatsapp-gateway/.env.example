# Copy ke .env di folder ini (whatsapp-gateway/.env), JANGAN commit .env asli.

PORT=3000

# HARUS sama persis dengan WHATSAPP_GATEWAY_HMAC_SECRET di root .env /
# app/.env — infra-level shared secret (APP_KEY-class), bukan credential
# bisnis. Lihat app/app/Support/WhatsappHmac.php.
WHATSAPP_GATEWAY_HMAC_SECRET=CHANGE_ME_STRONG_SHARED_SECRET

# boss-app itu sendiri cuma PHP-FPM (tidak listen HTTP) — boss-nginx adalah
# entrypoint HTTP di dalam boss-network, dipakai untuk POST balik
# connection.update ke /api/v1/whatsapp/webhook/session-status.
LARAVEL_BASE_URL=http://boss-nginx
