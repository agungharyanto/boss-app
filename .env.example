# ============================================
# BOSS App — Environment Template
# Copy ke .env lalu isi nilai asli. JANGAN commit .env
# ============================================

APP_NAME="BOSS App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=boss-postgresql
DB_PORT=5432
DB_DATABASE=boss_db
DB_USERNAME=boss_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_HOST=boss-redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- PostgreSQL container init (dipakai docker-compose) ---
POSTGRES_DB=boss_db
POSTGRES_USER=boss_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Xendit Payment Gateway (v0.3.5) — SANDBOX only this sprint ---
# Test-mode keys from the Xendit dashboard. JANGAN pernah isi production
# key di sini selama sprint ini masih berjalan di server dev — lihat
# CLAUDE.md untuk kenapa root .env ini adalah yang benar-benar dibaca
# container (bukan app/.env).
XENDIT_SECRET_KEY=CHANGE_ME_XENDIT_SANDBOX_SECRET_KEY
XENDIT_CALLBACK_TOKEN=CHANGE_ME_XENDIT_SANDBOX_CALLBACK_TOKEN
XENDIT_IS_PRODUCTION=false

# --- WhatsApp Gateway (Baileys, v0.4.0) ---
# whatsapp-gateway is a separate Node.js container on boss-network (see
# docker-compose.yml) — internal-only, never exposed to a host port.
# WHATSAPP_GATEWAY_HMAC_SECRET is an infra-level shared secret (like
# APP_KEY), NOT a business credential — it must be set to the SAME value
# in this file's real .env AND whatsapp-gateway/.env, or every signed
# request between the two services fails verification.
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3000
WHATSAPP_GATEWAY_HMAC_SECRET=CHANGE_ME_STRONG_SHARED_SECRET

# --- FreeRADIUS (v0.6.1) ---
# freeradius-db is a SEPARATE Postgres container from boss-postgresql
# (BOSS-009: radius_db logically separated from boss_db, no cross-database
# joins) — these values configure BOTH the freeradius-db container's own
# POSTGRES_* init AND the freeradius container's rlm_sql connection string
# (see docker/freeradius/mods-available/sql, read via $ENV{RADIUS_DB_*}).
# Mikrotik API credentials themselves are NOT here — they're per-NAS,
# encrypted columns on the `nas` table (see NasService), not a global env.
RADIUS_DB_HOST=freeradius-db
RADIUS_DB_PORT=5432
RADIUS_DB_NAME=radius_db
RADIUS_DB_USER=freeradius
RADIUS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# FREERADIUS_INTERNAL_IP must match the ipv4_address pinned to the
# freeradius service on boss-network in docker-compose.yml — the openvpn
# container's push-route AND its iptables FORWARD allowlist are both keyed
# off this exact value (see docker/openvpn/entrypoint.sh). Must stay inside
# the boss-network subnet declared in docker-compose.yml (172.28.0.0/24).
FREERADIUS_INTERNAL_IP=172.28.0.10

# GENIEACS_CWMP_INTERNAL_IP/GENIEACS_NBI_INTERNAL_IP (v0.7.3) must match the
# ipv4_address pinned to genieacs-cwmp/genieacs-nbi on boss-network in
# docker-compose.yml — the Connection Request firewall exception in
# docker/wireguard/entrypoint.sh (and openvpn's, for any NAS on that
# protocol) is keyed off these exact values, same "must not silently drift
# on container recreation" reasoning as FREERADIUS_INTERNAL_IP above. Must
# stay inside the boss-network subnet (172.28.0.0/24) and not collide with
# any other pinned or dynamically-assigned address.
GENIEACS_CWMP_INTERNAL_IP=172.28.0.30
GENIEACS_NBI_INTERNAL_IP=172.28.0.31

# WIREGUARD_NODE2_INTERNAL_IP/WIREGUARD_NODE3_INTERNAL_IP (added 2026-08-19,
# same day as the GATEWAY variable below) — pinned ipv4_address for
# wireguard-node2/wireguard-node3 on boss-network. Found missing during the
# Connection Request (v0.7.3) investigation: unlike wireguard (node1,
# already pinned to 172.28.0.11) and every other special-purpose container
# in this stack, node2/node3 had NO ipv4_address at all, so a plain
# recreate silently reassigned their addresses (confirmed for real: node3
# was 172.28.0.4, became 172.28.0.5 after one `docker compose up -d
# --force-recreate`) — which immediately broke TR069_MANAGEMENT_GATEWAY
# below, the exact "must not silently drift on container recreation"
# failure mode FREERADIUS_INTERNAL_IP/GENIEACS_*_INTERNAL_IP already exist
# to prevent, just never extended to these two services until now.
WIREGUARD_NODE2_INTERNAL_IP=172.28.0.4
WIREGUARD_NODE3_INTERNAL_IP=172.28.0.5

# TR069_MANAGEMENT_SUBNET (v0.7.3) — optional. When set, every WireGuard
# pool node (docker/wireguard/entrypoint.sh) adds a scoped firewall
# exception + AllowedIPs widening so GenieACS Connection Request can reach
# CPE behind whichever NAS actually has this exact subnet in its own
# nas.tr069_management_subnet column. Leave unset if no NAS has Connection
# Request routing configured yet. Only one subnet is supported this sprint
# (no per-NAS dynamic sync) — see CLAUDE.md "GenieACS Vendor Parameter
# Mapping" for the known limitation if this ever needs to support multiple
# NAS with DIFFERENT management subnets simultaneously.
TR069_MANAGEMENT_SUBNET=
# TR069_MANAGEMENT_GATEWAY — boss-network IP of whichever VPN pool node
# currently holds the relevant NAS's active WireGuard account (cross-check
# vpn_accounts.vpn_server_id -> vpn_servers.hostname against `docker
# network inspect`, or now, simpler: use the matching
# WIREGUARD_NODE2_INTERNAL_IP/WIREGUARD_NODE3_INTERNAL_IP value above /
# 172.28.0.11 for node1 — all three are pinned now, so this is the one
# thing here that's still genuinely static/manual: which NODE currently
# owns the NAS, not which IP that node has). Static/manual, known
# limitation — must be updated by hand if that NAS's account ever moves to
# a different pool node.
TR069_MANAGEMENT_GATEWAY=

# --- OpenVPN Server Node #1 (v0.6.2) ---
# VPN_SUBNET_* is the internal pool OpenVPN hands out to connecting NAS
# clients (must match vpn_servers.subnet_cidr for the node whose row
# represents this container — kept as plain env here since the openvpn
# container's own server.conf needs it before any DB even exists to read
# from). NETWORK/NETMASK are the same range as CIDR, just pre-split because
# OpenVPN's `server` directive wants netmask form, not CIDR notation.
VPN_SUBNET_CIDR=172.23.194.0/24
VPN_SUBNET_NETWORK=172.23.194.0
VPN_SUBNET_NETMASK=255.255.255.0

# The public IP NAS devices actually dial — same value across all three VPN
# protocol containers (one physical/virtual server, N=1 node), also stored
# in each vpn_servers row's public_ip column.
VPN_PUBLIC_IP=YOUR_SERVER_IP

# --- WireGuard (v0.6.3) --- own subnet, distinct from OpenVPN's, so the
# two containers never hand out overlapping internal_ip values.
WG_LISTEN_PORT=51820
WG_SUBNET_CIDR=172.23.195.0/24
WG_SUBNET_NETWORK_ADDR=172.23.195.1

# --- L2TP/IPsec (v0.6.3) --- L2TP_IPSEC_PSK is an infra-level shared secret
# (like WHATSAPP_GATEWAY_HMAC_SECRET) — ONE PSK for the whole node, not
# per-NAS (per-NAS identity/auth happens at the PPP/chap-secrets layer,
# via vpn_accounts.username/password).
L2TP_IPSEC_PSK=CHANGE_ME_STRONG_SHARED_SECRET
L2TP_LOCAL_IP=172.23.196.1
L2TP_IP_RANGE_START=172.23.196.10
L2TP_IP_RANGE_END=172.23.196.250
L2TP_SUBNET_CIDR=172.23.196.0/24

# --- GenieACS / MongoDB (v0.7.1) ---
# MongoDB is its own separate datastore for GenieACS — never boss_db/
# radius_db (BOSS-009: logically separated databases, no cross-database
# joins). Auth enabled even though the `mongo` container has no host port
# published and only genieacs-cwmp/nbi/fs ever talk to it — boss-network is
# shared with every other container in this stack, so credential-gating is
# still worthwhile defense-in-depth, same posture as boss-postgresql/
# freeradius-db even though those are also internal-only.
MONGO_DB_NAME=genieacs
MONGO_DB_USER=genieacs
MONGO_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# genieacs-nbi has NO authentication of its own (see docker-compose.yml's
# genieacs-nbi service comment) — network isolation (no host port, reached
# ONLY container-to-container inside boss-network) is its actual security
# boundary, so this URL only ever needs to be the internal container name.
GENIEACS_NBI_URL=http://genieacs-nbi:7557

# Signs JWT tokens genieacs-ui stores in browser cookies — only read by the
# genieacs-ui container itself (admin debugging UI, optional, no host port
# published), not by boss-app.
GENIEACS_UI_JWT_SECRET=CHANGE_ME_RANDOM_STRING

# --- Customer NIK encryption ---
# NIK_HMAC_KEY is an infra-level secret (like APP_KEY/WHATSAPP_GATEWAY_HMAC_SECRET),
# NOT reused from APP_KEY on purpose — it only ever hashes NIK values into
# customers.nik_hash (a deterministic HMAC, for unique-per-tenant lookups),
# never used to encrypt/decrypt anything itself. Rotating this key makes
# every existing nik_hash stop matching new lookups — don't rotate it
# without a re-backfill plan (see customers:backfill-nik-hash).
NIK_HMAC_KEY=CHANGE_ME_RANDOM_STRING

# --- CPE legacy device auto-matcher polling interval ---
# Read directly by boss-scheduler's entrypoint shell loop (docker-compose.yml),
# NOT by Laravel's Schedule — see routes/console.php's comment near
# AutoMatchLegacyDevices for why a sub-60s interval can't safely use
# Schedule::everyThirtySeconds() in this container's non-cron invocation
# pattern. 60 is the sane steady-state default; only go lower temporarily
# (e.g. while manually bulk-adding TR-069 profiles per-ONT and wanting fast
# match feedback) — changing this value needs `docker compose up -d
# boss-scheduler` to actually take effect (editing .env alone doesn't
# refresh an already-running container's env, same lesson as every other
# env_file entry in this file).
CPE_AUTO_MATCH_INTERVAL_SECONDS=60

# --- LibreNMS (v0.8.1) ---
# librenms-db (mariadb) credentials — own separate MySQL/MariaDB instance,
# never boss-postgresql (BOSS-009, and LibreNMS itself requires MySQL/
# MariaDB, not Postgres, so reuse was never an option).
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=librenms
LIBRENMS_DB_PASSWORD=CHANGE_ME_RANDOM_STRING

# LIBRENMS_API_URL/LIBRENMS_API_TOKEN — container-to-container URL
# (http://librenms:8000/api/v0, no host port published — see docker-
# compose.yml's librenms service comment) + the API token generated via
# `docker compose exec librenms lnms api-token:create <username>` (or the
# web UI). Never hardcode the token in code — App\Services\Network\
# LibrenmsClientService (once it exists) reads these the same way
# GenieAcsClientService reads services.genieacs.nbi_url.
LIBRENMS_API_URL=http://librenms:8000/api/v0
LIBRENMS_API_TOKEN=
